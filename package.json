{
	"name": "casebook",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22.12.0 <23"
	},
	"scripts": {
		"build": "moon run :build",
		"check": "moon run :check",
		"lint": "moon run :lint",
		"test": "moon run :test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"dev": "moon run web:dev",
		"dev:mcp": "moon run mcp:dev",
		"db:up": "docker compose up -d --wait postgres",
		"db:seed": "moon run store:seed",
		"db:down": "docker compose down",
		"deploy:local": "bash deploy/local/up.sh",
		"deploy:local:down": "bash deploy/local/down.sh"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@moonrepo/cli": "2.6.4",
		"@types/node": "22.20.5",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	}
}
