# Copy to .env and adjust. Matches the local Postgres in docker-compose.yml.
DATABASE_URL=postgres://casebook:casebook@127.0.0.1:5433/casebook

# Host port for the local Postgres container; change it (and DATABASE_URL) if 5433 is taken.
CASEBOOK_PG_PORT=5433

# Where files attached to cases are stored; defaults to .casebook/files under the working directory.
# CASEBOOK_FILES_DIR=/absolute/path/to/casebook-files

# The MCP server (`pnpm dev:mcp`): its port, the address it binds to, and its public origin when that is not http://localhost:<port>.
# CASEBOOK_MCP_PORT=5190
# CASEBOOK_MCP_HOST=127.0.0.1
# CASEBOOK_MCP_URL=http://localhost:5190
