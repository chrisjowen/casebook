# Copy to .env and adjust. Matches the local Postgres in docker-compose.yml.
DATABASE_URL=postgres://casebook:casebook@127.0.0.1:5433/casebook

# Host port for the local Postgres container; change it (and DATABASE_URL) if 5433 is taken.
CASEBOOK_PG_PORT=5433

# Where files attached to cases are stored; defaults to .casebook/files under the working directory.
# CASEBOOK_FILES_DIR=/absolute/path/to/casebook-files

# The IANA time zone conditions count calendar days in, for today(), days_since and dates; defaults to UTC.
# CASEBOOK_TIMEZONE=Asia/Singapore

# The MCP server (`pnpm dev:mcp`): its port, the address it binds to, and its public origin when that is not http://localhost:<port>.
# CASEBOOK_MCP_PORT=5190
# CASEBOOK_MCP_HOST=127.0.0.1
# CASEBOOK_MCP_URL=http://localhost:5190

# The spreadsheet wizard's chat model, as provider:model (ollama, anthropic or openai). Unset, it is
# anthropic:claude-sonnet-5 when ANTHROPIC_API_KEY is set and ollama:qwen2.5:7b when it is not.
# CASEBOOK_WIZARD_MODEL=ollama:qwen2.5:7b
# Claude's key; setting it is enough to run the wizard on Claude.
# ANTHROPIC_API_KEY=
# How hard Claude thinks before it answers (low, medium, high, xhigh or max); higher is slower.
# CASEBOOK_WIZARD_EFFORT=low
# Where Ollama runs, for ollama: models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# How long one assistant turn may run before it is stopped, in seconds.
# CASEBOOK_WIZARD_TIMEOUT_SECONDS=480
# The key for openai: models.
# OPENAI_API_KEY=
