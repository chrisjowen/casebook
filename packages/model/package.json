{
	"name": "@casebook/model",
	"version": "0.0.0",
	"private": true,
	"description": "Process definition model: node types, the process-definition JSON Schema, validation, publish checks, node operations, revisions and publish policies. Pure TypeScript, no I/O.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./fixtures": {
			"types": "./dist/fixtures/index.d.ts",
			"default": "./dist/fixtures/index.js"
		},
		"./schema/process-definition.schema.json": "./schema/process-definition.schema.json"
	},
	"files": [
		"dist",
		"schema"
	],
	"devDependencies": {
		"@types/node": "22.20.5",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"ajv": "8.20.0"
	}
}
